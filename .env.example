# Copy to .env and fill in. .env is gitignored: never commit it or paste these values into chat.

# AI: Claude by default. Or ASU Voyager (Anthropic-compatible): put its key here, uncomment the base URL and set the
# model to one with the Vision badge.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://openai.rc.asu.edu

# Texts, option 1: Twilio (console.twilio.com -> Account Info on the home page)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Or an API key (Console -> Account -> API keys & tokens) instead of the Auth Token; still needs the Account SID
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Your Twilio trial number, like +14805551234
TWILIO_FROM=

# Texts, option 2 (fallback): a Telegram bot from @BotFather (/newbot). Then send your bot /start.
TELEGRAM_BOT_TOKEN=

# Your own verified phone, like +14805551234. The test text goes here.
TEST_PHONE=

# The address phones use to reach this app (for magic links and QR codes), like https://xyz.trycloudflare.com
BASE_URL=http://localhost:8000
